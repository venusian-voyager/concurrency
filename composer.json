{
    "name": "venusian-voyager/concurrency",
    "description": "The Voyager Concurrency package.",
    "license": "MIT",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        },
        {
            "name": "Taylor Otwell"
        }
    ],
    "require": {
        "php": "^8.4|^8.5",
        "laravel/serializable-closure": "^2.0",
        "venusian-voyager/console": "^0.9.0",
        "venusian-voyager/contracts": "^0.9.0",
        "venusian-voyager/nuts-and-bolts": "^0.9.0",
        "venusian-voyager/process": "^0.9.0"
    },
    "suggest": {
        "spatie/fork": "Required to use the fork concurrency driver (^1.2)."
    },
    "autoload": {
        "psr-4": {
            "Voyager\\Concurrency\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.9.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev"
}
